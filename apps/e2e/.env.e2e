# Config for the isolated e2e docker compose stack (project: thanks-claude-e2e).
# Keeps e2e off the dev stack's ports/db so both can run at the same time.
# Loaded by e2e.config.ts and passed to docker compose via --env-file.
WEB_PORT=8082
POSTGRES_PORT=5434
POSTGRES_DB=thanks_claude_e2e
POSTGRES_USER=thanks_claude
POSTGRES_PASSWORD=thanks_claude
