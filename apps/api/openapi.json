  "info": {
    "title": "thanks-claude API",
    "description": "",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "CreateLikeDto": {
        "type": "object",
        "properties": {
          "story": {
            "type": "string"
          },
          "hoursSaved": {
            "type": "number"
          }
        }
      },
      "LikeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "story": {
            "type": "string",
            "nullable": true
          },
          "hoursSaved": {
            "type": "number",
            "nullable": true
          }
        },
        "required": [
          "id",
          "createdAt",
          "story",
          "hoursSaved"
        ]
      },
      "LikeCountDto": {
        "type": "object",
        "properties": {
          "count": {
            "type": "number"
          }
        },
        "required": [
          "count"
        ]
      },
      "LikesStatsDto": {
        "type": "object",
        "properties": {
          "totalLikes": {
            "type": "number"
          },
          "likesWithHoursReported": {
            "type": "number"
          },
          "reportedHoursSaved": {
            "type": "number"
          },
          "percentWithoutHoursReported": {
            "type": "number"
          },
          "averageHoursPerReport": {
            "type": "number"
          },
          "estimatedTotalHoursSaved": {
            "type": "number"
          }
        },
        "required": [
          "totalLikes",
          "likesWithHoursReported",
          "reportedHoursSaved",
          "percentWithoutHoursReported",
          "averageHoursPerReport",
          "estimatedTotalHoursSaved"
        ]
      },
      "LikeFeedItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "story": {
            "type": "string",
            "nullable": true
          },
          "hoursSaved": {
            "type": "number",
            "nullable": true
          },
          "attributedUserName": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "createdAt",
          "story",
          "hoursSaved",
          "attributedUserName"
        ]
      },
      "LikesPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LikeFeedItemDto"
            }
          },
          "total": {
            "type": "number"
          },
          "page": {
            "type": "number"
          },
          "limit": {
            "type": "number"
          },
          "totalPages": {
            "type": "number"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "limit",
          "totalPages"
        ]
      },
      "SignupDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 6
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "AuthUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "MeResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/AuthUserDto"
              }
            ]
          }
        },
        "required": [
          "user"
        ]
      }
    }
  }
}