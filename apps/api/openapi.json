    "/likes/stats": {
      "get": {
        "operationId": "LikesController_getStats",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LikesStatsDto"
                }
              }
            }
          }
        },
        "tags": [
          "Likes"
        ]
